// Prisma schema for the Fakire Fashion / Zainaz tailor-shop rebuild.
// Designed fresh (not a literal port of the legacy MySQL dump).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  customer
  admin
  tailor
}

enum Gender {
  male
  female
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

enum StitchStatus {
  not_started
  pending
  stitched
  out_for_delivery
  delivered
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  mobile       String?
  address      String?
  role         Role     @default(customer)
  /// Customers and admins are always approved. Tailors start unapproved and need
  /// an admin to approve them (via /admin/tailors) before they can log in.
  approved     Boolean  @default(true)
  createdAt    DateTime @default(now())

  cartItems     CartItem[]
  orders        Order[]
  stitchOrders  StitchOrder[]
  wishlistItems WishlistItem[]

  @@map("users")
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String
  slug   String @unique
  status Boolean @default(true)

  subCategories SubCategory[]
  products      Product[]

  @@map("categories")
}

model SubCategory {
  id         Int    @id @default(autoincrement())
  categoryId Int
  name       String
  slug       String

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@map("sub_categories")
}

model Product {
  id              Int      @id @default(autoincrement())
  categoryId      Int
  subCategoryId   Int?
  name            String
  code            String   @unique
  description     String?
  mrp             Decimal  @db.Decimal(10, 2)
  price           Decimal  @db.Decimal(10, 2)
  metaTitle       String?
  metaDescription String?
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())

  category      Category       @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory?   @relation(fields: [subCategoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@map("products")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  size      String
  color     String
  mrp       Decimal @db.Decimal(10, 2)
  price     Decimal @db.Decimal(10, 2)
  qty       Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  variantId Int?
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
  @@map("cart_items")
}

model Order {
  id               Int         @id @default(autoincrement())
  orderNumber      String      @unique
  userId           Int
  totalAmount      Decimal     @db.Decimal(10, 2)
  discountAmount   Decimal     @db.Decimal(10, 2) @default(0)
  netAmount        Decimal     @db.Decimal(10, 2)
  shippingCharges  Decimal     @db.Decimal(10, 2) @default(0)
  status           OrderStatus @default(pending)
  name             String
  email            String
  mobile           String
  address          String
  createdAt        DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  variantId   Int?
  productName String
  price       Decimal @db.Decimal(10, 2)
  qty         Int
  color       String?
  size        String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model StitchCategory {
  id     Int     @id @default(autoincrement())
  name   String
  gender Gender  @default(male)
  status Boolean @default(true)
  image  String?

  stitchOrders StitchOrder[]

  @@map("stitch_categories")
}

model StitchOrder {
  id                 Int          @id @default(autoincrement())
  userId             Int
  stitchCategoryId   Int
  measurements       Json
  suitImage          String?
  customerName       String
  customerEmail      String
  customerMobile     String
  customerAddress    String
  preferredDate      DateTime
  preferredTimeSlot  String
  visitCompleted     Boolean      @default(false)
  status             StitchStatus @default(not_started)
  createdAt          DateTime     @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stitchCategory StitchCategory @relation(fields: [stitchCategoryId], references: [id])

  @@map("stitch_orders")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  mobile    String?
  message   String
  createdAt DateTime @default(now())

  @@map("enquiries")
}

model Coupon {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  discountPercent Decimal  @db.Decimal(5, 2) @default(0)
  discountValue   Decimal  @db.Decimal(10, 2) @default(0)
  startDate       DateTime
  endDate         DateTime
  status          Boolean  @default(true)

  @@map("coupons")
}

/// Editable homepage content (hero image/copy, etc). One row per named section,
/// e.g. key = "homepage". Admins edit this via /admin/content instead of code changes.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

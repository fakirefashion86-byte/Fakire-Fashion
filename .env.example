DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Optional: a non-pooled connection string, used only by `prisma migrate` for DDL.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
JWT_SECRET="a-long-random-string"

# Google Maps Platform browser key (Maps JavaScript API + Places API enabled).
# Used by the checkout delivery-location picker. Restrict it by HTTP referrer
# in Google Cloud Console — see the setup instructions in the location feature docs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
